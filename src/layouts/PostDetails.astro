---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import TableOfContents from "@components/TableOfContents.astro";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import PostEndNav from "@components/PostEndNav.astro";
import PostViews from "@components/PostViews";
import formatDate from "@utils/formatDate";
import getReadingTime from "@utils/getReadingTime";
import getTocHeadings from "@utils/getTocHeadings";
import getExcerpt from "@utils/getExcerpt";
import { LOCALE, SITE } from "@config";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;

const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
  lang,
} = post.data;

const { Content, headings } = await post.render();
const tocHeadings = getTocHeadings(headings);
const readingTime = getReadingTime(post.body);
const isUpdated = modDatetime && modDatetime > pubDatetime;

const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.url.origin,
).href;

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description: description.trim() || getExcerpt(post.body) || undefined,
  pubDatetime,
  modDatetime,
  canonicalURL,
  ogImage: ogUrl,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav="posts" />
  <main id="main-content" tabindex="-1">
    <nav class="post-crumb meta-text" aria-label="breadcrumb">
      <a href="/posts/">← Posts</a>
      {
        tags[0] && (
          <>
            <span aria-hidden="true"> / </span>
            <a href={`/tags/${slugifyStr(tags[0])}/`}>{slugifyStr(tags[0])}</a>
          </>
        )
      }
    </nav>
    <header class="post-header">
      <h1 transition:name={slugifyStr(title)} class="post-title" {lang}>
        {title}
      </h1>
      {
        description.trim() && (
          <p class="post-description" {lang}>
            {description}
          </p>
        )
      }
      <p class="post-meta meta-text">
        <time datetime={pubDatetime.toISOString()}>
          {formatDate(pubDatetime, LOCALE.langTag)}
        </time>
        {
          isUpdated && (
            <span>
              · updated{" "}
              <time datetime={modDatetime.toISOString()}>
                {formatDate(modDatetime, LOCALE.langTag)}
              </time>
            </span>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
        <PostViews slug={post.slug} client:visible />
      </p>
      <ul class="post-tags">
        {tags.map((tag) => <Tag tag={slugifyStr(tag)} />)}
      </ul>
    </header>

    <div class:list={["post-layout", { "has-toc": tocHeadings.length > 0 }]}>
      <div class="post-column min-w-0">
        {
          tocHeadings.length > 0 && (
            <div class="lg:hidden">
              <TableOfContents headings={tocHeadings} variant="inline" />
            </div>
          )
        }
        <article id="article" class="prose" {lang}>
          <Content />
        </article>
      </div>
      {
        tocHeadings.length > 0 && (
          <aside class="hidden lg:block">
            <TableOfContents headings={tocHeadings} variant="sidebar" />
          </aside>
        )
      }
    </div>

    <footer class="post-footer">
      <p class="post-author">
        Written by <span class="post-author-name">{SITE.title}</span>, usually
        over coffee at 3AM.
        <a href="/about/" class="post-author-more">More about me</a>
      </p>
      <PostEndNav {post} />
      <div class="post-footer-row">
        <ShareLinks />
        <button
          id="back-to-top"
          type="button"
          class={cn(
            buttonVariants({ variant: "ghost" }),
            "-mr-4 ml-auto min-h-11 text-muted-foreground",
          )}
        >
          Back to top
        </button>
      </div>
      <p id="post-status" class="sr-only" aria-live="polite"></p>
    </footer>
  </main>
  <Footer />
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-5xl px-4 pb-12;
  }
  main:focus {
    @apply outline-none;
  }
  .post-crumb {
    @apply mt-8;
  }
  .post-crumb a {
    @apply hover:text-primary;
  }
  .post-header {
    @apply max-w-3xl pt-4;
  }
  .post-title {
    @apply text-4xl font-semibold leading-[1.1] [text-wrap:balance] sm:text-5xl;
  }
  .post-description {
    @apply mt-4 text-lg leading-8 text-muted-foreground;
  }
  .post-meta {
    @apply mt-5 flex flex-wrap items-center gap-x-2 gap-y-1;
  }
  .post-tags {
    @apply mt-4 flex flex-wrap gap-2;
  }
  .post-layout {
    @apply mt-10 border-t border-border pt-10;
  }
  .post-layout.has-toc {
    @apply lg:grid lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-12;
  }
  /* 36rem of Geist at 18px ≈ 72–75 characters per line. */
  .post-layout .prose {
    @apply max-w-[36rem];
  }
  .post-footer {
    @apply mt-16 flex max-w-[36rem] flex-col gap-8 border-t border-border pt-8;
  }
  .post-author {
    @apply text-base leading-7;
  }
  .post-author-name {
    @apply font-medium text-foreground;
  }
  .post-author-more {
    @apply whitespace-nowrap text-primary underline decoration-primary/40 underline-offset-4 hover:decoration-primary;
  }
  .post-footer-row {
    @apply flex flex-wrap items-center justify-between gap-x-4 gap-y-2;
  }
</style>

<script is:inline>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  /** Reading-progress bar along the top edge (decorative, hidden from AT). */
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-30 h-[3px] w-full bg-transparent";
    progressContainer.setAttribute("aria-hidden", "true");
    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-full w-0 bg-primary";
    progressBar.id = "myBar";
    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    const bar = document.getElementById("myBar");
    if (!bar) return;
    const root = document.documentElement;
    const scrollable = root.scrollHeight - root.clientHeight;
    const scrolled = scrollable > 0 ? (root.scrollTop / scrollable) * 100 : 0;
    bar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
  }
  // View transitions re-run this script on every visit; bind the listener once.
  if (!window.__postScrollBound) {
    window.__postScrollBound = true;
    document.addEventListener("scroll", updateScrollProgress, {
      passive: true,
    });
  }
  updateScrollProgress();

  /**
   * Section links on headings, for mouse users who want to share a section.
   * Hidden from assistive tech and the tab order: inside a heading, a named
   * link would be read as part of the heading's own name. Keyboard and
   * screen-reader users reach sections through the table of contents.
   */
  function addHeadingLinks() {
    const headings = document.querySelectorAll(
      "#article h2, #article h3, #article h4, #article h5, #article h6",
    );
    for (const heading of headings) {
      if (!heading.id) continue;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.textContent = "#";
      link.className = "heading-link";
      link.href = `#${heading.id}`;
      link.setAttribute("aria-hidden", "true");
      link.tabIndex = -1;
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  /** Copy buttons on code blocks, announced to screen readers. */
  function attachCopyButtons() {
    const copyButtonLabel = "Copy";
    const status = document.getElementById("post-status");
    if (!status) return;

    for (const codeBlock of document.querySelectorAll("#article pre")) {
      const wrapper = document.createElement("div");
      wrapper.className = "code-block";

      // Shiki sets data-language; untagged fences come through as "plaintext".
      const lang = codeBlock.dataset.language;
      const hasLang = lang && !["plaintext", "text", "txt"].includes(lang);
      const name = hasLang ? `${lang} code` : "code";

      const copyButton = document.createElement("button");
      copyButton.className = "copy-code";
      copyButton.type = "button";
      copyButton.textContent = copyButtonLabel;
      copyButton.setAttribute("aria-label", `Copy ${name}`);

      // Focusable so keyboard users can scroll wide code; named as a region.
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.setAttribute("role", "region");
      codeBlock.setAttribute(
        "aria-label",
        name.charAt(0).toUpperCase() + name.slice(1),
      );

      codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      if (hasLang) {
        const label = document.createElement("span");
        label.className = "code-lang";
        label.textContent = lang;
        label.setAttribute("aria-hidden", "true");
        wrapper.appendChild(label);
      }
      wrapper.appendChild(copyButton);

      // Fade the right edge while there is more code to scroll to.
      const updateScrollHint = () => {
        const remaining =
          codeBlock.scrollWidth - codeBlock.clientWidth - codeBlock.scrollLeft;
        wrapper.dataset.scrollMore = String(remaining > 2);
      };
      codeBlock.addEventListener("scroll", updateScrollHint, {
        passive: true,
      });
      new ResizeObserver(updateScrollHint).observe(codeBlock);
      updateScrollHint();

      let resetTimer;
      copyButton.addEventListener("click", async () => {
        const text = codeBlock.querySelector("code")?.innerText ?? "";
        let message;
        try {
          await navigator.clipboard.writeText(text);
          copyButton.textContent = "Copied";
          message = "Code copied to clipboard";
        } catch {
          copyButton.textContent = "Press Ctrl+C";
          message = "Copy failed. Select the code and press Control C.";
          const range = document.createRange();
          range.selectNodeContents(
            codeBlock.querySelector("code") ?? codeBlock,
          );
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        status.textContent = message;
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          copyButton.textContent = copyButtonLabel;
          status.textContent = "";
        }, 2000);
      });
    }
  }
  attachCopyButtons();

  /** "Copy link" in the share row. */
  function copyLink() {
    const button = document.querySelector("[data-copy-link]");
    const label = button?.querySelector("[data-copy-label]");
    const status = document.getElementById("post-status");
    if (!button || !label || !status) return;
    let resetTimer;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        label.textContent = "Link copied";
        status.textContent = "Link copied to clipboard";
      } catch {
        label.textContent = "Copy failed";
        status.textContent =
          "Copy failed. Copy the address from the address bar.";
      }
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        label.textContent = "Copy link";
        status.textContent = "";
      }, 2000);
    });
  }
  copyLink();

  /** Back to top: scroll up and move keyboard focus with it. */
  function backToTop() {
    document.querySelector("#back-to-top")?.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
      document.getElementById("main-content")?.focus({ preventScroll: true });
    });
  }
  backToTop();

  /** Highlights the TOC entry for the heading currently in view. */
  function spyToc() {
    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (links.length === 0) return;
    const targets = links
      .map((link) => document.getElementById(link.dataset.tocLink))
      .filter(Boolean);
    const setActive = (id) =>
      links.forEach((link) => {
        const active = link.dataset.tocLink === id;
        link.setAttribute("data-active", String(active));
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-80px 0px -70% 0px" },
    );
    targets.forEach((target) => observer.observe(target));
  }
  spyToc();
</script>
