---
import { badgeVariants } from "@/components/ui/badge";
import { cn } from "@/lib/utils";

export interface Props {
  tag: string;
  count?: number;
  size?: "sm" | "lg";
  /** Set false when the same tag is rendered twice on a page (names must be unique). */
  transition?: boolean;
}

const { tag, count, size = "sm", transition = true } = Astro.props;
const pillClass = cn(
  badgeVariants({ variant: "tag" }),
  "tag-pill rounded-full",
  size === "lg" && "px-3 py-1 text-sm",
);
---

<li class="inline-block">
  {
    transition ? (
      <a href={`/tags/${tag}/`} transition:name={tag} class={pillClass}>
        #{tag}
        {count !== undefined && <span class="tag-count">{count}</span>}
      </a>
    ) : (
      <a href={`/tags/${tag}/`} class={pillClass}>
        #{tag}
        {count !== undefined && <span class="tag-count">{count}</span>}
      </a>
    )
  }
</li>

<style>
  .tag-pill {
    @apply relative gap-1.5 font-normal;
  }
  /* enlarge the hit area to ≥ 44px without enlarging the pill */
  .tag-pill::after {
    content: "";
    @apply absolute -inset-y-3 inset-x-0;
  }
  .tag-count {
    @apply font-mono text-[0.7rem] opacity-70;
  }
</style>
