---
import socialIcons from "@assets/socialIcons";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const url = encodeURIComponent(Astro.url.href);

const shareLinks = [
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer.php?u=${url}`,
    label: "Share on Facebook",
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`,
    label: "Share on LinkedIn",
  },
] as const;

const iconButton = cn(
  buttonVariants({ variant: "ghost", size: "icon" }),
  "share-button size-11",
);
---

<div class="share">
  <span class="meta-text">Share</span>
  <button
    type="button"
    class={cn(
      buttonVariants({ variant: "ghost" }),
      "share-button min-h-11 gap-2 px-3",
    )}
    data-copy-link
  >
    <svg
      class="lucide"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
      ></path>
      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
      ></path>
    </svg>
    <span data-copy-label>Copy link</span>
  </button>
  {
    shareLinks.map((link) => (
      <a
        href={link.href}
        class={iconButton}
        aria-label={link.label}
        title={link.label}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Fragment set:html={socialIcons[link.name]} />
      </a>
    ))
  }
</div>

<style>
  .share {
    @apply flex flex-wrap items-center gap-1;
  }
  .share .meta-text {
    @apply mr-1;
  }
  .share-button {
    @apply text-muted-foreground hover:text-primary;
  }
  .share-button :global(svg) {
    @apply size-5;
  }
  .share-button:hover :global(svg:not(.lucide)) {
    @apply fill-primary;
  }
</style>
