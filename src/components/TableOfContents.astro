---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
  variant: "sidebar" | "inline";
}

const { headings, variant } = Astro.props;
const isSidebar = variant === "sidebar";
---

{
  isSidebar ? (
    <nav class="toc-sidebar" aria-label="On this page">
      <p class="meta-text toc-heading">On this page</p>
      <ol class="toc-list">
        {headings.map(({ depth, slug, text }) => (
          <li class:list={[{ "pl-3": depth === 3 }]}>
            <a href={`#${slug}`} class="toc-link" data-toc-link={slug}>
              {text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="toc-inline">
      <summary class="meta-text">
        On this page
        <svg
          class="toc-chevron lucide"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ol class="toc-list">
        {headings.map(({ depth, slug, text }) => (
          <li class:list={[{ "pl-3": depth === 3 }]}>
            <a href={`#${slug}`} class="toc-link" data-toc-link={slug}>
              {text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .toc-sidebar {
    @apply sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto border-l border-border pl-4;
  }
  .toc-heading {
    @apply mb-2 uppercase;
  }
  .toc-inline {
    @apply mb-8 rounded-xl border border-border bg-card px-4 py-3;
  }
  .toc-inline summary {
    @apply flex min-h-11 cursor-pointer list-none items-center justify-between uppercase;
  }
  .toc-inline summary::-webkit-details-marker {
    display: none;
  }
  .toc-chevron {
    @apply size-4 shrink-0 transition-transform duration-200 motion-reduce:transition-none;
  }
  .toc-inline[open] .toc-chevron {
    @apply rotate-180;
  }
  .toc-list {
    @apply flex flex-col text-sm;
  }
  .toc-link {
    @apply -ml-[17px] block border-l-2 border-transparent py-1.5 pl-[15px] text-muted-foreground hover:text-foreground;
  }
  .toc-inline .toc-link {
    @apply ml-0 flex min-h-11 items-center border-l-0 pl-0;
  }
  .toc-link[data-active="true"] {
    @apply border-primary font-medium text-primary;
  }
</style>
