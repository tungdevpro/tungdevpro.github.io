---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import PostMeta from "./PostMeta.astro";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, lang } = post.data;
---

<li>
  <a href={`/posts/${post.slug}/`} class="featured-card group">
    <PostMeta {post} />
    <h3
      class="featured-title"
      style={`view-transition-name: ${slugifyStr(title)}`}
      {lang}
    >
      {title}
    </h3>
    {
      description && (
        <p class="featured-desc" {lang}>
          {description}
        </p>
      )
    }
  </a>
</li>

<style>
  .featured-card {
    @apply flex h-full flex-col gap-2 rounded-xl border border-border bg-card p-5 transition-colors hover:border-primary/50;
  }
  .featured-title {
    @apply text-xl font-semibold leading-snug text-foreground [text-wrap:balance] group-hover:text-primary;
  }
  .featured-desc {
    @apply line-clamp-2 text-sm text-muted-foreground;
  }
</style>
