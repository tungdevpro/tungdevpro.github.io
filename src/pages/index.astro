---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FeaturedCard from "@components/FeaturedCard.astro";
import PostRow from "@components/PostRow.astro";
import getSortedPosts from "@utils/getSortedPosts";
import getHomePosts from "@utils/getHomePosts";
import { SITE, SOCIALS } from "@config";
import { buttonVariants } from "@/components/ui/button";

const posts = await getCollection("blog");
const { featured, recent } = getHomePosts(getSortedPosts(posts));
const github = SOCIALS.find(
  (social) => social.name === "Github" && social.active,
);
---

<Layout description={SITE.quickIntroduceMySelf}>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1>{SITE.headline}</h1>
      <p class="intro">{SITE.quickIntroduceMySelf}</p>
      <p class="fact">{SITE.fact}</p>
      <div class="hero-actions">
        <a
          href="/posts/"
          class={buttonVariants({ className: "min-h-11 rounded-full px-5" })}
        >
          Read the blog
        </a>
        <a href="/about/" class="about-link">About me</a>
        {
          github && (
            <a
              href={github.href}
              class="about-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          )
        }
      </div>
    </section>

    {
      featured.length > 0 && (
        <section id="featured" aria-labelledby="featured-heading">
          <div class="section-heading">
            <h2 id="featured-heading">Featured</h2>
          </div>
          <ul class="featured-grid">
            {featured.map((post) => (
              <FeaturedCard post={post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section id="recent-posts" aria-labelledby="recent-heading">
          <div class="section-heading">
            <h2 id="recent-heading">Recent writing</h2>
            <a href="/posts/" class="all-link">
              All posts →
            </a>
          </div>
          <ul class="post-list">
            {recent.map((post) => (
              <PostRow post={post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  #hero {
    @apply pb-8 pt-14 sm:pb-12 sm:pt-24;
  }
  #hero h1 {
    @apply max-w-3xl text-4xl font-semibold leading-[1.1] [text-wrap:balance] sm:text-6xl;
  }
  /* 36rem keeps the intro under 80 characters per line (see DESIGN.md Measure Rule). */
  .intro {
    @apply mt-5 max-w-[36rem] text-base leading-7 text-muted-foreground [text-wrap:pretty] sm:text-lg sm:leading-8;
  }
  .fact {
    @apply mt-3 max-w-[36rem] text-base leading-7 text-foreground sm:text-lg;
  }
  .hero-actions {
    @apply mt-7 flex flex-wrap items-center gap-4;
  }
  .about-link {
    @apply inline-flex min-h-11 items-center text-sm text-muted-foreground underline decoration-border underline-offset-4 hover:text-foreground hover:decoration-foreground;
  }
  #featured,
  #recent-posts {
    @apply pb-8 pt-6;
  }
  .section-heading {
    @apply mb-4 flex items-baseline justify-between gap-3;
  }
  .section-heading h2 {
    @apply text-2xl font-semibold;
  }
  .all-link {
    @apply inline-flex min-h-11 items-center text-sm text-primary hover:underline;
  }
  .featured-grid {
    @apply grid gap-3 sm:grid-cols-2;
  }
  main {
    @apply pb-12;
  }
</style>
